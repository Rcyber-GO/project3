          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"Harga tetap 5000 dari server\", () => pm.expect(d.items[0].price).to.eql(5000));",
              "pm.test(\"Total 10000, bukan 1\", () => pm.expect(d.total).to.eql(10000));"
            ]
          }
