{
  "info": {
    "name": "Stateless Shopping Cart - Modul 4b",
    "description": "Koleksi pengujian Modul Praktikum 4 (Stateless Shopping Cart). Jalankan berurutan: request pertama mengambil token CSRF secara otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "csrf_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Ambil token CSRF (GET /)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const m = pm.response.text().match(/name=\"csrf-token\" content=\"([^\"]+)\"/);",
              "pm.test(\"Token CSRF ditemukan\", () => pm.expect(m).to.not.be.null);",
              "pm.collectionVariables.set(\"csrf_token\", m[1]);",
              "console.log(\"Token CSRF:\", m[1]);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            ""
          ]
        }
      }
    },
    {
      "name": "2. Tambah Pulpen - tanpa token CSRF (harus 419)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 419 (CSRF ditolak)\", () => pm.response.to.have.status(419));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cart\": {\n    \"1\": 2\n  },\n  \"product_id\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/cart/add",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "cart",
            "add"
          ]
        }
      }
    },
    {
      "name": "3. Tambah Pulpen - kirim ke-1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"Buku Tulis x2, Pulpen x1\", () => { pm.expect(d.items[0].quantity).to.eql(2); pm.expect(d.items[1].quantity).to.eql(1); });",
              "pm.test(\"Total 13000\", () => pm.expect(d.total).to.eql(13000));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrf_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cart\": {\n    \"1\": 2\n  },\n  \"product_id\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/cart/add",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "cart",
            "add"
          ]
        }
      }
    },
